# ==============================================================================
# SpareRoute Backend — Environment Configuration Template
# Copy this file to .env and fill in values.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Runtime environment ('development', 'staging', 'production')
# In 'production':
#   - KYC_PROVIDER_NAME must NOT be 'stub'
#   - ALLOWED_ORIGINS cannot contain '*' or 'localhost'
#   - All secrets must be at least 32 characters long and not contain placeholder names
NODE_ENV=development

# Port to listen on (SpareRoute default: 4000 in compose, 5000 in standalone)
PORT=4000

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spareroute_db

# ------------------------------------------------------------------------------
# JWT Authentication Secrets
# Generate random 64-byte hex strings using: openssl rand -hex 64
# Must be at least 32 characters in production.
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_at_least_32_chars_random_secret_for_access_token
JWT_REFRESH_SECRET=replace_with_different_at_least_32_chars_random_secret_for_refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Password hashing cost factor (bcrypt)
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# CORS & Reverse Proxy
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
# Production refuses to boot if this contains localhost or '*'
ALLOWED_ORIGINS=https://app.spareroute.example.com

# Number of reverse proxy hops to trust for req.ip (e.g. 1 if behind Cloudflare/AWS ALB/Nginx)
TRUST_PROXY=0

# ------------------------------------------------------------------------------
# KYC Verification Provider (Aadhaar verification)
# 'stub' is allowed only in development and staging (emits warning in staging).
# In production, must be a real provider (e.g. digio, sandbox).
# ------------------------------------------------------------------------------
KYC_PROVIDER_NAME=stub
KYC_PROVIDER_API_KEY=replace_with_kyc_provider_api_key
KYC_PROVIDER_API_SECRET=replace_with_kyc_provider_api_secret
KYC_PROVIDER_BASE_URL=https://api.provider.example.com

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
# General window in milliseconds (default: 15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window for general endpoints (default: 100)
RATE_LIMIT_MAX_REQUESTS=100
# Max requests per window for auth endpoints like login/register (default: 5)
AUTH_RATE_LIMIT_MAX=5

# ------------------------------------------------------------------------------
# Internal Server-to-Server Communication (Inquest -> SpareRoute)
# Shared secret for internal API calls from Inquest backend.
# Must match SPAREROUTE_INTERNAL_API_KEY in inquest-backend/.env.
# Must be at least 32 characters long in production.
# ------------------------------------------------------------------------------
INTERNAL_API_KEY=replace_with_shared_32_plus_char_secret_between_services

# ------------------------------------------------------------------------------
# Return Window
# Number of days after delivery during which customers can request returns.
# Must match Inquest POLICY3 eligible_within_days. Default: 10
# ------------------------------------------------------------------------------
RETURN_WINDOW_DAYS=10

# ------------------------------------------------------------------------------
# Delivery OTP Encryption Secret
# Key used for encrypting delivery OTP codes with AES-256-GCM.
# In production, must be at least 32 characters and not a placeholder.
# In non-production, if unset, derived from JWT_ACCESS_SECRET via HMAC-SHA256.
# ------------------------------------------------------------------------------
DELIVERY_OTP_SECRET=replace_with_at_least_32_chars_random_secret_for_delivery_otp

