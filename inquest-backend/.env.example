# ==============================================================================
# Inquest Backend — Environment Configuration Template
# Copy this file to .env and fill in values.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Runtime environment ('development', 'staging', 'production')
# In 'production':
#   - CORS_ORIGIN cannot contain '*' or 'localhost'
#   - Secrets (JWT_ACCESS_SECRET, SPAREROUTE_INTERNAL_API_KEY) must be >= 32 chars
#     and not contain placeholder names
NODE_ENV=development

# Port to listen on (Inquest default: 5001)
PORT=5001

# PostgreSQL connection string for inquest database
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inquest_db

# ------------------------------------------------------------------------------
# Authentication & SpareRoute Integration
# ------------------------------------------------------------------------------
# Shared JWT access secret from SpareRoute (Inquest verifies SpareRoute tokens)
# Must match JWT_ACCESS_SECRET in backend/.env. Must be >= 32 characters in production.
JWT_ACCESS_SECRET=replace_with_shared_32_plus_char_jwt_access_secret

# SpareRoute backend URL for internal data queries
SPAREROUTE_API_URL=http://localhost:4000

# Shared internal API key to authenticate requests against SpareRoute internal endpoints
# Must match INTERNAL_API_KEY in backend/.env. Must be >= 32 characters in production.
SPAREROUTE_INTERNAL_API_KEY=replace_with_shared_32_plus_char_secret_between_services

# ------------------------------------------------------------------------------
# AI Provider (Google Gemini)
# ------------------------------------------------------------------------------
# Primary Google Gemini API key
GEMINI_API_KEY=replace_with_google_gemini_api_key

# Optional secondary fallback Gemini API key
GEMINI_API_KEY_BACKUP=

# ------------------------------------------------------------------------------
# CORS & Reverse Proxy
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g. Inquest admin dashboard)
# Production refuses to boot if this contains localhost or '*'
CORS_ORIGIN=https://admin.inquest.example.com

# Maximum request body size for JSON/urlencoded payloads (default: 1mb)
BODY_LIMIT=1mb

# Number of reverse proxy hops to trust for req.ip (e.g. 1 if behind Cloudflare/AWS ALB/Nginx)
TRUST_PROXY=0

# ------------------------------------------------------------------------------
# Per-User Rate Limiting (Hourly Caps)
# Keyed by authenticated user ID; runs after requireAuth and before validators
# ------------------------------------------------------------------------------
# Maximum complaints a single user can submit per hour (default: 10)
RATE_LIMIT_COMPLAINTS_MAX=10

# Maximum verification requests a single user can submit per hour (default: 20)
RATE_LIMIT_VERIFY_MAX=20
