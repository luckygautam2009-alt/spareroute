# Copy this file to .env and fill in REAL values.
# NEVER commit the actual .env file to git.

NODE_ENV=development
PORT=5000

# --- Database ---
DATABASE_URL=postgresql://username:password@localhost:5432/spareparts_db

# --- JWT ---
# Generate strong random secrets with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace_with_a_64_byte_random_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_64_byte_random_hex_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Password hashing ---
BCRYPT_SALT_ROUNDS=12

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# --- KYC Provider (Aadhaar verification) ---
# We NEVER store raw Aadhaar numbers. We only store the provider's
# verification reference ID and status.
KYC_PROVIDER_NAME=digio
KYC_PROVIDER_API_KEY=replace_with_real_key_from_provider
KYC_PROVIDER_API_SECRET=replace_with_real_secret_from_provider
KYC_PROVIDER_BASE_URL=https://api.digio.in

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
